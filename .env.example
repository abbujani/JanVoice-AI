# ==============================================================================
# JanVoice Legal Access - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# The pattern below mirrors ./vite.config.ts and backend/config.py.
# ==============================================================================

# FRONTEND CONFIGURATIONS (VITE CLIENT)
# ------------------------------------------------------------------------------
# FastAPI backend URL (leave empty in production to use relative /api on the
# same origin; set to http://localhost:8000 for local development)
VITE_API_URL=http://localhost:8000

# Firebase Client SDK Credentials (optional; enables real sign-in for per-account history)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# BACKEND CONFIGURATIONS (FASTAPI SERVER)
# ------------------------------------------------------------------------------
# Gemini API Key (optional; required for AI analysis. Without it the API returns
# a conservative local action plan and does not analyze document contents.)
GEMINI_API_KEY=

# Gemini model used for legal analysis and document interpretation
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:5173

# Server deployment port
PORT=8000